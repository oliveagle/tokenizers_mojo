def ref_ids(i: Int) -> List[Int]:
    var out = List[Int]()
    if i == 0:
        for v in [383, 2068, 7586, 21831, 18045, 625, 262, 16931, 3290]: out.append(v)
        return out^
    elif i == 1:
        for v in [18435, 11, 616, 995, 0]: out.append(v)
        return out^
    elif i == 2:
        for v in [770, 318, 257, 2829, 6827, 329, 262, 7523, 1332, 13]: out.append(v)
        return out^
    elif i == 3:
        for v in [402, 11571, 12, 17, 3544, 18022, 1241, 11241, 1634]: out.append(v)
        return out^
    elif i == 4:
        for v in [317, 1790, 530, 13]: out.append(v)
        return out^
    elif i == 5:
        for v in [3146, 17031, 290, 604, 3980, 1656, 994]: out.append(v)
        return out^
    elif i == 6:
        for v in [383, 614, 1160, 2075, 318, 2406, 2582]: out.append(v)
        return out^
    elif i == 7:
        for v in [4946, 20185, 2716, 402, 11571, 12, 17, 287, 13130]: out.append(v)
        return out^
    return out^

